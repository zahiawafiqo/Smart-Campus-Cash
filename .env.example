# Konfigurasi Aplikasi
APP_NAME="Smart Campus Cash"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sistem%20keuangan/public

# Konfigurasi Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_campus_cash
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi AI & Chatbot
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_KEY_ID=your_nvidia_key_id_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NODE_CHATBOT_PORT=3001
NODE_CHATBOT_URL=http://localhost:3001

# Konfigurasi WhatsApp API Fonnte (https://docs.fonnte.com)
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_DEVICE_URL=https://api.fonnte.com/device

# Konfigurasi Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
